#!/bin/sh
# fp-grid-start - start the two Front Panel v4 small-icon columns (if not already running).
# sessionetc runs this at login; run it by hand after "Restart Workspace Manager" if needed.
# Single instance per column (flock in fp-grid-left/right). Read-only; draws icons only.
for g in fp-grid-left fp-grid-right; do
    [ -x "$HOME/bin/$g" ] && setsid "$HOME/bin/$g" >/dev/null 2>&1 </dev/null &
done
